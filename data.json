  "papers": [
    {
      "title": "Reducing Computational Complexity in CNNs: A Focus on VGG19 Pruning and Quantization",
      "year": "2025",
      "subtitle": "Published in International Journal of Advanced Computer Science and Applications(ijacsa), Volume 16 Issue 6, 2025",
      "description": "CNNs like VGG19 excel in computer vision but demand significant computational resources, hindering low-end device use. This study explores enhancing VGG19 efficiency via model compression: pruning (structured and unstructured) and quantization (8-bit and 4-bit QAT). Tested on MNIST, CIFAR-10, and Oxford-IIIT Pet, methods reduced model size by up to 75% with lowered computational costs. 8-bit QAT notably compressed systems without sacrificing speed or accuracy. However, 4-bit QAT, despite 48% compression, reduced accuracy on complex datasets. Structured pruning sped up inference, and unstructured pruning improved accuracy, simplifying VGG19 for edge device implementation while maintaining prediction quality.",
      "pdf_link": "papers/1.pdf",
      "authors": [
        {
          "name": "Md. Mijanur Rahman",
          "website": "#"
        },
        {
          "name": "Anik Datta",
          "website": "http://auniik.github.io",
